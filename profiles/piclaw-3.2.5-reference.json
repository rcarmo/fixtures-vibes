{
  "runtime": "piclaw",
  "version": "3.2.5",
  "external": {
    "baseUrl": "http://192.168.1.236:8090",
    "modelControlUrl": "http://192.168.1.236:9920"
  },
  "readiness": {
    "path": "/agent/status",
    "status": 200,
    "timeoutMs": 30000
  },
  "session": {
    "create": {
      "method": "POST",
      "path": "/agent/root-session",
      "body": {
        "agent_name": "{name}"
      },
      "idField": "branch.chat_jid"
    },
    "open": "/?chat_jid={id}"
  },
  "auth": {
    "mode": "none"
  },
  "capabilities": [
    "@cap-adaptive-cards",
    "@cap-addons",
    "@cap-agent-avatar",
    "@cap-attachments",
    "@cap-auth-login",
    "@cap-auth-passkey",
    "@cap-auth-totp",
    "@cap-compaction",
    "@cap-context-meter",
    "@cap-editor",
    "@cap-image-annotation",
    "@cap-message-delete",
    "@cap-messages-tool",
    "@cap-model-picker",
    "@cap-multi-user",
    "@cap-plan-sidebar",
    "@cap-push-notifications",
    "@cap-pwa",
    "@cap-queue",
    "@cap-quick-actions",
    "@cap-read-aloud",
    "@cap-reconnect",
    "@cap-recordings",
    "@cap-scheduled-tasks",
    "@cap-search",
    "@cap-session-manage",
    "@cap-session-picker",
    "@cap-settings-dialog",
    "@cap-skills",
    "@cap-slash-commands",
    "@cap-steer",
    "@cap-steer-idle",
    "@cap-stop",
    "@cap-svg-render",
    "@cap-system-meters",
    "@cap-terminal",
    "@cap-text-highlights",
    "@cap-theme-tint",
    "@cap-thinking-levels",
    "@cap-thoughts",
    "@cap-tool-output",
    "@cap-touch",
    "@cap-vnc",
    "@cap-widgets",
    "@cap-workspace",
    "@cap-workspace-write"
  ],
  "skips": "piclaw-3.2.5-skips.json",
  "tools": {
    "activate": "activate_tools"
  },
  "commands": {
    "setAgentAvatar": "/agent-avatar {source}",
    "clearAgentAvatar": "/agent-avatar clear"
  }
}
