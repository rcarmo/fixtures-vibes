{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rcarmo/fixtures-vibes/schemas/evidence-manifest.schema.json",
  "title": "fixtures-vibes evidence manifest",
  "description": "Maps scenario IDs to tests that prove them. The shared compliance suite generates one per run; runtimes may add one for runtime-internal tests that also evidence a scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime", "fixturesVibes", "entries"],
  "properties": {
    "runtime": { "type": "string" },
    "fixturesVibes": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tests"],
        "properties": {
          "id": { "type": "string", "pattern": "^@(ux|shared)-[a-z0-9-]+$" },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "title"],
              "properties": {
                "file": { "type": "string" },
                "title": { "type": "string" },
                "project": { "type": "string", "description": "Playwright project (browser/viewport) when applicable." }
              }
            }
          }
        }
      }
    }
  }
}
